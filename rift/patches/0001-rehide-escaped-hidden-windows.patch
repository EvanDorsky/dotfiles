+    /// For a window on an inactive virtual workspace (i.e. one rift keeps off-screen),
+    /// reports whether `frame` is meaningfully on-screen (`Some(true)`, an escape) or
+    /// off-screen (`Some(false)`, hidden, possibly clamped by macOS). `None` for windows
+    /// on the active workspace or without a known space.
+    fn hidden_window_escape_state(&self, wid: WindowId, frame: &CGRect) -> Option<bool> {
+        let space = self.assigned_space_for_window_id(wid)?;
+        if self.layout_manager.layout_engine.is_window_in_active_workspace(
+            &self.state.windows,
+            space,
+            wid,
+        ) {
+            return None;
+        }
+        let screen = self.space_state.screen_by_space(space)?.frame;
+        let visible_w = (frame.max().x.min(screen.max().x) - frame.origin.x.max(screen.origin.x)).max(0.0);
+        let visible_h = (frame.max().y.min(screen.max().y) - frame.origin.y.max(screen.origin.y)).max(0.0);
+        // Hidden windows show at most a sliver (rift's own threshold is 3px; macOS
+        // clamping can leave a title bar's worth). Anything larger is an escape.
+        const ESCAPE_PX: f64 = 64.0;
+        Some(visible_w > ESCAPE_PX && visible_h > ESCAPE_PX)
+    }
