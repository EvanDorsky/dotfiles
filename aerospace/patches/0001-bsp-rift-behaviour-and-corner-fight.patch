+/// Apps AeroSpace hid with macOS app-hiding to end a corner-hiding fight, and when.
+/// They're unhidden again when a workspace holding one of their windows becomes visible.
+@MainActor var appsHiddenToEndCornerFight: [Int32: ContinuousClock.Instant] = [:]
+
+@MainActor
+func unhideAppsHiddenToEndCornerFight(onVisible workspace: Workspace) {
+    for pid in Array(appsHiddenToEndCornerFight.keys) {
+        let windows = MacWindow.allWindows.filter { $0.macApp.pid == pid }
+        guard let app = windows.first?.macApp else {
+            appsHiddenToEndCornerFight.removeValue(forKey: pid) // app quit
+            continue
+        }
+        if !app.nsApp.isHidden { // user unhid it (cmd-tab, Dock)
+            appsHiddenToEndCornerFight.removeValue(forKey: pid)
+            continue
+        }
+        if windows.contains(where: { $0.nodeWorkspace === workspace }) {
+            app.nsApp.unhide()
+            appsHiddenToEndCornerFight.removeValue(forKey: pid)
+        }
+    }
+}
+
+extension Rect {
+    /// A window parked in a corner leaves at most a sliver on screen (and macOS may clamp it
+    /// a little further in). Anything larger means the app moved it back.
+    func isMeaningfullyVisible(in screen: Rect) -> Bool {
+        let w = min(maxX, screen.maxX) - max(minX, screen.minX)
+        let h = min(maxY, screen.maxY) - max(minY, screen.minY)
+        return w > 64 && h > 64
+    }
+}
